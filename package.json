{
  "name": "secureops-siem",
  "version": "1.0.0",
  "private": true,
  "description": "Centralized security event monitoring with AI detection - diploma project",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/ensure-model.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-model.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib server config tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/ensure-model.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "train:model": "node scripts/train-model.mjs",
    "train:python": "python ml/train.py --synthetic"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "jose": "^5.9.6",
    "lenis": "^1.1.18",
    "next": "15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
