# Required in production: random secret, minimum 32 characters
AUTH_SECRET=
NEXT_PUBLIC_SITE_URL=https://YOUR_PROJECT.vercel.app
ADMIN_EMAIL=admin@aspan-security.kz
# Generate a bcrypt hash locally, never commit a real password
ADMIN_PASSWORD_HASH=
# [{"email":"analyst@example.test","passwordHash":"bcrypt-hash","role":"analyst"}]
USERS_JSON=[]
DEMO_MODE_ENABLED=1
# Optional bootstrap agent token; alternatively create a revocable token in Settings
INGEST_TOKEN=
# Optional persistent store + distributed rate limits; both values required
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional notifications, only new real high/critical cases
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
# Optional OpenAI-compatible HTTPS summarizer, identifiers/logs excluded
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Default model is synthetic; probability contributes to triage only.
# Enable standalone model alerts only after validating on your own data.
ML_FLOW_ALERTS=0
IP_MASKING=0
# Optional local agent variables, never set agent file paths on Vercel
AGENT_LOG_FILE=
AGENT_INGEST_URL=
AGENT_TOKEN=
AGENT_FROM_START=0
