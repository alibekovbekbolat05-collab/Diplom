# ---- Core ----
# Signing key for session cookies (REQUIRED in production). Generate: openssl rand -base64 32
AUTH_SECRET=change-me-32-bytes-min-random-string

# Public site URL, used for canonical/OG/sitemap
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ---- Seed admin user ----
ADMIN_EMAIL=admin@aspan-security.kz
# bcrypt hash, generate with: node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" 'YourPassword'
ADMIN_PASSWORD_HASH=

# Optional extra users: JSON array [{email, passwordHash, role}]
USERS_JSON=[]

# ---- Demo mode (read-only "Open demo" session). 0 to disable ----
DEMO_MODE_ENABLED=1

# ---- Ingest ----
# Bootstrap ingest token for POST /api/ingest (agents)
INGEST_TOKEN=

# ---- State adapter (optional; empty = in-memory + /tmp persistence) ----
STATE_ADAPTER=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Database adapter (optional) ----
DATABASE_URL=

# ---- Notifications (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=

# ---- Threat intel feeds (optional; bundled snapshot works with no keys) ----
ABUSEIPDB_API_KEY=
THREAT_FEED_URLHAUS=0
THREAT_FEED_FEODO=0

# ---- LLM assistant (optional, OFF by default) ----
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---- Analytics (optional; cookie banner appears only when set) ----
NEXT_PUBLIC_ANALYTICS=

# ---- Misc ----
IP_MASKING=0
CONTACT_RATE_LIMIT=5
